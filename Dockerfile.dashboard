
# Dockerfile for DevOps Continuous Testing Dashboard & Engine Hub

FROM python:3.10-slim

WORKDIR /app

ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Copy application, engine, tests, and dashboard
COPY app/ /app/app/
COPY tests/ /app/tests/
COPY engine/ /app/engine/
COPY dashboard/ /app/dashboard/
COPY requirements.txt /app/

# Create reports directory
RUN mkdir -p /app/reports

# Install Python dependencies
RUN python -m pip install --no-cache-dir -r requirements.txt

# Expose dashboard port
EXPOSE 8080

# Check dashboard API health
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/api/status', timeout=3)" || exit 1

# Start dashboard server
CMD ["python", "dashboard/server.py"]
